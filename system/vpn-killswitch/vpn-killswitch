#!/usr/bin/env bash
# Killswitch OpenVPN (NetworkManager) basado en UFW.
# Config: /etc/vpn-killswitch.conf (ceft-shell: plantilla: system/vpn-killswitch/killswitch.conf.example)
# Uso: sudo vpn-killswitch on|off|sync|status    ·    vpn-killswitch state (sin root)
set -euo pipefail

VPN_SERVER="" VPN_PORT="1194" VPN_PROTO="udp" VPN_IF="tun0" WAN_IF="" LAN_NET="192.168.0.0/24"
CONF=/etc/vpn-killswitch.conf
# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"
# WAN: la configurada, o la interfaz de la ruta por defecto que no sea la VPN
if [[ -z $WAN_IF ]]; then
  WAN_IF=$(ip -o route show default 2>/dev/null | awk -v v="$VPN_IF" '$5 != v {print $5; exit}')
fi
TAG="killswitch"

# Bloqueos (van primero): nada de DNS al router con el killswitch activo
DENY=(
  "deny out on $WAN_IF to $LAN_NET port 53 comment $TAG"
  "deny out on $WAN_IF to $LAN_NET port 853 comment $TAG"
)
# Salidas permitidas
ALLOW=(
  "allow out on $VPN_IF comment $TAG"
  "allow out on $WAN_IF to $VPN_SERVER port $VPN_PORT proto $VPN_PROTO comment $TAG"
  "allow out on $WAN_IF to $LAN_NET comment $TAG"
  "allow out on $WAN_IF proto udp from any port 68 to any port 67 comment $TAG"
  "allow out on docker0 comment $TAG"
  "allow out on br-+ comment $TAG"
)

is_on() { grep -q '^DEFAULT_OUTPUT_POLICY="DROP"' /etc/default/ufw; }

if [[ "${1:-}" == state ]]; then is_on && echo on || echo off; exit 0; fi
[[ $EUID -eq 0 ]] || { echo "Ejecutar con sudo"; exit 1; }
[[ -n $VPN_SERVER && -n $WAN_IF ]] || { echo "Falta VPN_SERVER o WAN_IF en $CONF"; exit 1; }

# Docker no pasa por las reglas de salida de UFW: bloqueamos en DOCKER-USER
DOCKER_RULES=(
  "-o $WAN_IF ! -d $LAN_NET -j DROP"
  "-o $WAN_IF -d $LAN_NET -p udp --dport 53 -j DROP"
  "-o $WAN_IF -d $LAN_NET -p tcp --dport 53 -j DROP"
)
docker_block() {   # $1 = -I (insertar) o -D (borrar)
  iptables -L DOCKER-USER -n >/dev/null 2>&1 || return 0
  for r in "${DOCKER_RULES[@]}"; do
    while iptables -D DOCKER-USER $r 2>/dev/null; do :; done   # sin duplicados
    [[ "$1" == -I ]] && iptables -I DOCKER-USER $r
  done
  return 0
}

case "${1:-}" in
  on)
    for r in "${ALLOW[@]}"; do ufw $r >/dev/null; done
    for r in "${DENY[@]}";  do ufw delete ${r% comment*} >/dev/null 2>&1 || true; ufw insert 1 $r >/dev/null; done
    ufw default deny outgoing >/dev/null
    docker_block -I
    echo "Killswitch ACTIVADO"
    ;;
  off)
    ufw default allow outgoing >/dev/null
    for r in "${DENY[@]}" "${ALLOW[@]}"; do ufw delete ${r% comment*} >/dev/null 2>&1 || true; done
    docker_block -D
    echo "Killswitch DESACTIVADO"
    ;;
  sync)   # re-aplicar reglas de Docker (tras reiniciar o reiniciar docker)
    is_on && docker_block -I || docker_block -D
    ;;
  status)
    ufw status verbose
    iptables -L DOCKER-USER -n 2>/dev/null || true
    ;;
  *) echo "Uso: sudo $0 on|off|sync|status  ·  $0 state"; exit 1 ;;
esac
